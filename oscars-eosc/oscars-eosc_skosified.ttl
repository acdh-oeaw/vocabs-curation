@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/AuthenticationAndAuthorisationInfrastructure> a skos:Concept ;
    dc:source "EOSCFuture project glossary"@en ;
    skos:altLabel "AAI"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Service> ;
    skos:definition "service (or distributed set of services) which enables users to be identified and to access protected information, other services or functionality."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "Authentication and Authorisation Infrastructure"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/CompetenceCentre> a skos:Concept ;
    dc:source "https://oscars-project.eu/clusters-open-science-competence-centres"@en ;
    skos:definition "virtual hub dedicated to fostering research excellence through training and knowledge transfer."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "Specifically in the context of OSCARS: community-based initiative supported by a collaborative science cluster network of people providing expertise, best practices and services in relation to Open Science, and the promotion of cross-disciplinary collaboration."@en ;
    skos:prefLabel "competence centre"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Composability> a skos:Concept ;
    dc:source "OSCARS D2.1 - Clusters' Services and Data Sources Portfolios; https://zenodo.org/records/14881627"@en ;
    skos:definition "ability to combine and integrate smaller, modular components or services into more complex systems"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "composability"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DataCuration> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "ISO 5127:2017, modified –– reference to data instead of data/data collections."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "managed process, throughout the ​data life-cycle​, by which ​data are cleansed, documented, standardized, formatted and interrelated."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "data curation"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DataInfrastructure> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "digital infrastructure​ enabling ​services​ for supporting the ​data life-cycle​."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "data infrastructure"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DataLifeCycle> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "RDA DFT IG. (2019). Term Definitions Version 4.0 \"Philadelphia\". https://smw-rda.esc.rzg.mpg.de/dft-4.0.html​, modified –– reference to data instead of digital information; ​following the comments​ the concept has been added."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "all stages in the existence of ​data​ from creation to destruction."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "data life-cycle"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DataManagementPlan> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:altLabel "DMP"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/DataManagement> ;
    skos:definition "document describing the data that is used and produced during the course of research activities."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "A variant is the notion of machine-actionable DMP (maDMP): a structured digital format for research data plans that allows systems and tools to automatically rprocess project information and to enable the exchange of information between systems acting on behalf of stakeholders involved in the research life cycle, such as, researchers, funders, repository managers, ICT providers, librarians, etc."@en ;
    skos:prefLabel "data management plan"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DataStewardship> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "RDA DFT working group. (2019). DFT Vocabulary 4.0 Philadelphia. https://smw-rda.esc.rzg.mpg.de/dft-4.0.html​, modified –– reference to data management instead of management; reference to data instead of data assets/resources; reference to end-users instead of business users."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/DataManagement> ;
    skos:definition "formalized ​data management and oversight of an ​organization​'s ​data (by a data steward) to help provide ​end-users​ with high-quality data that is easily accessible in a consistent manner."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "A DMP specifies where the data will be archived, which licenses and constraints apply, to whom credit should be given, etc."@en ;
    skos:prefLabel "data stewardship"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DescriptiveMetadata> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "Riley, J., & National Information Standards Organization (U.S.). (2017). Understanding metadata: What is metadata, and what is it for? http://www.niso.org/publications/understanding-metadata-riley​, modified –– reference to resource."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Metadata> ;
    skos:definition "metadata​ about the content of a ​resource​ that aids in finding or understanding it."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "descriptive metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DigitalData> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "information in digital form"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "digital data"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DigitalInfrastructure> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en ;
    skos:definition "infrastructure constituted by a physical layer (hardware) and an abstraction layer (software) that is based on the physical one."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "Digital infrastructures, unlike physical ones, are generative: they can be used recursively to create new digital infrastructures."@en ;
    skos:prefLabel "digital infrastructure"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EInfrastructure> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:definition "infrastructure enabling digital services for data- and computing-intensive research in virtual and collaborative environments."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "e-infrastructure"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EOSCHorizonEuropeproject> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources;"@en ;
    skos:definition "project funded under Horizon Europe to support the implementation of EOSC."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "See also: https://eosc.eu/horizon-europe-projects"@en ;
    skos:prefLabel "EOSC Horizon Europe project"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Envri> a skos:Concept ;
    dc:source "https://envri.eu/"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ScienceCluster> ;
    skos:definition "European network of environmental research infrastructures, projects, and stakeholders working together to advance environmental research"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "ENVRI"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Eosc> a skos:Concept ;
    dc:source "https://eosc.eu/eosc-about"@en ;
    skos:altLabel "EOSC"@en ;
    skos:definition "European initiative to develop a ‘Web of FAIR Data and Services’ for science in Europe where researchers can publish, find and re-use data, tools and services, enabling them to better conduct their work."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "European Open Science Cloud"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Eosc-aTaskForces> a skos:Concept ;
    dc:source "https://eosc.eu/eosc-association/eosc-task-forces"@en ;
    skos:definition "expert groups that liaise with the EOSC-related Horizon Europe projects and the EOSC Opportunity Area Expert Groups to offer input and recommendations on targeted areas of EOSC’s development."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC-A Task Forces"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscAssociation> a skos:Concept ;
    dc:source "EOSCFuture project glossary"@en ;
    skos:altLabel "EOSC-A"@en ;
    skos:definition "international non-profit organisation (AISBL) based in Brussels to represent the interest of the EOSC stakeholder community."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "Domain: EOSC Association"@en,
        "The association is a partner with the European Commission in the EOSC Partnership and has developed and will continuously update a Strategic Research and Innovation Agenda (SRIA) to advise the European Commission on the development and implementation of EOSC."@en ;
    skos:prefLabel "EOSC Association"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscBoardOfDirectors> a skos:Concept ;
    dc:source "https://eosc.eu/eosc-association/board-directors"@en ;
    skos:definition "body of representatives of the EOSC Association that is responsible for the day-to-day operational management of the EOSC Association. The board reports to the general assembly."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC Board of Directors"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscExchange> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:definition """the set of services, datasets and other
research products collectively provided by EOSC Nodes and made accessible through
the EOSC Federation."""@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC Exchange"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscFederationHandbook> a skos:Concept ;
    dc:source "https://eosc.eu/building-the-eosc-federation/eosc-federation-handbook; see also: https://zenodo.org/records/18454649"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscFederation> ;
    skos:definition "document describing the organisational and operational structure and technical characteristics of the EOSC Federation."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC Federation Handbook"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscGeneralAssembly> a skos:Concept ;
    dc:source "https://eosc.eu/members"@en ;
    skos:definition "the supreme authority of the EOSC Association, composed of one delegate per member with voting rights and one representative per observer without voting rights."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC General Assembly"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscInteroperabilityFramework> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:altLabel "EOSC-IF"@en ;
    skos:definition "extensible framework of guidelines that define the technical requirements to implement the interoperability and composability of the EOSC Federated resources."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "EOSC IF promotes standards and best practices while allowing providers the freedom to develop and operate provider-specific implementations that conform to the EOSC IF guidelines and standards."@en ;
    skos:prefLabel "EOSC IF"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscKnowledgeHub> a skos:Concept ;
    dc:source "EOSCFuture project glossary"@en,
        "https://wiki.eoscfuture.eu/display/PUBLIC/EOSC+Future+Glossary"@en ;
    skos:definition "curated collection of resources supporting EOSC users and stakeholders in understanding and contributing to EOSC."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC knowledge hub"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscMandatedOrganisation> a skos:Concept ;
    dc:source "EOSC AISBL Statutes, (2020), FINAL. https://www.eoscsecretariat.eu/sites/default/files/eosc_statutes.pdf​."@en,
        "adapted from https://eosc.eu/eosc-association/mandated-organisations"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscMember> ;
    skos:definition "​EOSC-A member​ appointed by the governement of a country to represent the national interests in EOSC."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC Mandated Organisation"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscNationalTripartitieEvent> a skos:Concept ;
    dc:source "https://eosc.eu/tripartite-collaboration"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscTripartiteGovernance> ;
    skos:definition "series of events organised by the EOSC-A to more deeply engage the Member States and the Associated Countries in EOSC"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "Post-event reports and presentations from these events can be found on the individual country pages."@en ;
    skos:prefLabel "EOSC national tripartitie event"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscObserver> a skos:Concept ;
    dc:source "EOSC AISBL Statutes, (2020), FINAL. https://www.eoscsecretariat.eu/sites/default/files/eosc_statutes.pdf​"@en,
        "EOSC Glossary September 2020"@en ;
    skos:definition "​legal entity​ admitted to the ​EOSC Association​ with limited rights."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "An Observer can not vote at the ​General Assembly​ or propose candidates for the ​Board​."@en ;
    skos:prefLabel "EOSC Observer"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscOpportunityAreaExpertGroups> a skos:Concept ;
    dc:source "https://eosc.eu/eosc-opportunity-area-expert-groups"@en ;
    skos:definition "mechanism for collaboration on technical and related matters within the Horizon Europe Co-programmed Partnership for EOSC."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC Opportunity Area Expert Groups"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscPartnership> a skos:Concept ;
    dc:source "EOSC Executive Board. (2020). Draft proposal for a European Partnership under Horizon Europe European Open Science Cloud (EOSC) Partnership. https://ec.europa.eu/info/sites/info/files/research_and_innovation/funding/documents/ec_rtd_he- partnership-open-science-cloud-eosc.pdf​."@en,
        "EOSC Glossary September 2020"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EuropeanPartnership> ;
    skos:definition "co-programmed European Partnership between the EOSC Association and the European Commission that consolidates the outputs of EOSC projects from Horizon2020 and further develops EOSC."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "For details, see the EOSC Federation Handbook"@en,
        "The EOSC Partnership is funded through structured funding under Horizon Europe and in-kind contributions from member countries and stakeholders."@en ;
    skos:prefLabel "EOSC Partnership"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscResearchProductCatalogue> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscResourceCatalogue> ;
    skos:definition "catalogue of digital objects created during the research lifecycle, such as publications, datasets, and software that facilitates discovery and access to research products registered within the EOSC Federation."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC research product catalogue"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscResourceProvider> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:definition "organisation making a resource available by onboarding it to an EOSC Node."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC resource provider"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscSecretariat> a skos:Concept ;
    dc:source "https://eosc.eu/eosc-association/secretariat"@en ;
    skos:definition "body that supports the Board and the General Assembly of the EOSC Association, by advising them and coordinating and implementing their decisions."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC Secretariat"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscServiceCatalogue> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscResourceCatalogue> ;
    skos:definition """catalogue for EOSC Node service providers to describe their service offerings using
a service metadata profile."""@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC service catalogue"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscUser> a skos:Concept ;
    dc:source "EOSC Federation Handbook (shortened); https://zenodo.org/records/18454649;"@en ;
    skos:definition "person who is granted access to the EOSC Federation resources based on the recognition of their identity by a service provider registered with the EOSC AAI system"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC user"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscWorkProgramme> a skos:Concept ;
    dc:source "EOSCFuture project glossary"@en,
        "https://www.eosc.eu/sites/default/files/EOSC-SRIA-V1.0_15Feb2021.pdf"@en ;
    skos:definition "strategic planning document which outlines the specific EOSC implementation activities to be funded by the European Commission under Horizon Europe."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EOSC Work Programme"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Escape> a skos:Concept ;
    dc:source "https://projectescape.eu/about-us"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ScienceCluster> ;
    skos:definition "collaborative cluster of next generation European infrastructural facilities in the area of astronomy- and accelerator-based particle physics aimed at implementing a functional link with the European Open Science Cloud (EOSC)."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "ESCAPE"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EuNode> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscNode> ;
    skos:definition """fully operational platform providing access to a portfolio of professional-quality
research services and resources and enabling with Federating Capabilities the development of
the EOSC Federation."""@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "EU Node"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/FairDigitalObject> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:altLabel "FDO"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/DigitalObject> ;
    skos:definition "autonomous, machine-actionable digital object that packages data together with essential metadata, globally unique PIDs, and operational rules."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "FAIR digital object"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/FairPrinciples> a skos:Concept ;
    dc:source "COMMISSION DECISION of 27.8.2018 Setting up the Expert Group - Executive Board of the European Open Science Cloud ('EOSC') and laying down rules for its financing"@en,
        "EOSC Glossary September 2020"@en ;
    skos:altLabel "FAIR Guiding Principles"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/FairData> ;
    skos:definition "set of guidelines to make ​data​ Findable, Accessible, Interoperable, and Reusable."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "FAIR principles"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/FederationCapabilities> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:definition "system of services provided by more than one EOSC Node in order to implement the federation of resources in the EOSC Federation"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "federation capabilities"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/GenericRepository> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "Wittenburg, P. (2019). Role of Repositories in Research Infrastructure Building [Repository Topic Group Report"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchDataRepository> ;
    skos:definition "repository​ directed to all research disciplines."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "generic repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/HorizontalServices> a skos:Concept ;
    dc:source "Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Resource> ;
    skos:definition "cross-disciplinary infrastructure resource that is designed to support researchers across all scientific domains,."@en ;
    skos:example "Horizontal services include virtual machines, cloud containers, bulk data transfer, file synchronization and sharing, notebooks, and large file transfer."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "The terms 'common service' and 'generic service' are in use as synonym for 'horizontal service'.  The complement is 'thematic service'."@en ;
    skos:prefLabel "horizontal service"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Hpc> a skos:Concept ;
    dc:source "ISO: https://www.iso.org/obp/ui/#iso:std:iso-iec:21836:ed-1:v1:en:term:3.1.24"@en ;
    skos:definition "computing designed, marketed, sold, and optimized to execute highly parallel applications for high performance, deep learning, or artificial intelligence applications"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "HPC"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/KnowledgeGraph> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources, among which ISO: https://www.iso.org/obp/ui/#iso:std:iso-iec:5392:ed-1:v1:en:term:3.14"@en ;
    skos:altLabel "KG"@en ;
    skos:definition "structured representation of knowledge as a network of entities and their relationships, typically as (subject–predicate–object) triples;"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "A KG can comprise an ontology and data related to the ontology."@en,
        "Examples of narrower terms are Scholarly Knowledge Graph and Scientific Knowledge Graph (both commonly abbreviated as SKG)."@en,
        "KGs support search and discovery, inference, and integration across heterogeneous sources."@en ;
    skos:prefLabel "knowledge graph"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/LifeScienceResearchInfrastructure> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources, among which https://lifescience-ri.eu/"@en ;
    skos:altLabel "LSRI"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ScienceCluster> ;
    skos:definition "a cluster of European research infrastructures and related organisations that support research and innovation in life sciences by providing access to data, services, tools, facilities and expertise"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "Life Science Research Infrastructures"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/NationalEoscNode> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscNode> ;
    skos:definition "country-specific platforms and infrastructures that connect the local national research communities to the EOSC ecosystem."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "national EOSC Node"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/OpenAccess> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Access> ;
    skos:definition "access model that enables the re-use of digital research outputs with as few restrictions as possible."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "Open access is the opposite of closed access."@en ;
    skos:prefLabel "open access"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/OpenData> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "data​ in an open format that can be freely used, re-used and shared by anyone for any purpose."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "open data"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/OpenScience> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en,
        "https://www.unesco.org/en/open-science"@en ;
    skos:altLabel "OS"@en ;
    skos:definition "the practice of making science more accessible, inclusive and equitable for all"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "open science"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Panosc> a skos:Concept ;
    dc:source "https://www.panosc.eu/"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ScienceCluster> ;
    skos:definition "science cluster representing infrastructured for photon and neutron research, developing and providing services for its scientific community and connecting these to EOSC"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "PaNOSC"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Persistentdentifier> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:altLabel "PID"@en ;
    skos:definition "long-lasting reference to a digital object, essential for findability."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "persistent identifier"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/PersonalData> a skos:Concept ;
    dc:source "EOSCFuture project glossary"@en,
        "https://gdpr-info.eu/art-4-gdpr/"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "any information related to an identified or identifiable natural person ('data subject')."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "An identifiable natural person is one who can be identified, directly or indirectly, in particular by reference to an identifier such as a name, an identification number, location data, an online identifier or to one or more factors specific to the physical, physiological, genetic, mental, economic, cultural or social identity of that natural person."@en ;
    skos:prefLabel "personal data"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/PreservationMetadata> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "Riley, J., & National Information Standards Organization (U.S.). (2017). Understanding metadata: What is metadata, and what is it for? http://www.niso.org/publications/understanding-metadata-riley​, modified –– reference to resources instead of digital files; preservation metadata are not considered just administrative metadata, rather they span all metadata categories (see PREMIS Editorial Committee. (2015). PREMIS Data Dictionary for Preservation Metadata​ (version 3.0).)."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Metadata> ;
    skos:definition "metadata​ for supporting the long-term management and future migration or emulation of resources​."@en ;
    skos:example "Checksum, hash, structural metadata."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "preservation metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ProvenanceMetadata> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "ISO/TR 14873:2013"@en ;
    skos:altLabel "context metadata"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/AdministrativeMetadata> ;
    skos:definition "administrative metadata​ describing the lifecycle of a ​resource​ to a point, including the related entities and processes."@en ;
    skos:example "Configuration and log files."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "provenance metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/RawData> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "ISO 5127:2017."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "data​ in its originally acquired, direct form from its source before subsequent processing."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "raw data"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchCommunity> a skos:Concept ;
    dc:source "EOSCFuture project glossary"@en,
        "https://wiki.eoscfuture.eu/display/PUBLIC/EOSC+Future+Glossary"@en ;
    skos:definition "community of researchers working in a specific domain or with specific interests."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "research community"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchData> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "data and associated metadata created or collected as a part of scientific research or of relevance to scientific research."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "In the ​EOSC ecosystem​ research data can be digital, analogue or heterogeneous in nature."@en ;
    skos:prefLabel "research data"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/RightsMetadata> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "ISO/TR 14873:2013, modified –– reference to resource instead of object."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/AdministrativeMetadata> ;
    skos:definition "administrative metadata​ defining the ownership and the legally permitted usage of a ​resource​."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "rights metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ScienceClustes> a skos:Concept ;
    dc:source "https://science-clusters.eu/"@en,
        "https://zenodo.org/records/17224742"@en ;
    skos:definition "network grown out of five collaborative projects funded by the European Union in 2019 to link ESFRI and other world-class Research Infrastructures (RIs) to EOSC"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "science clusters"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Sshoc> a skos:Concept ;
    dc:source "https://sshoc.eu/news/sshoc-ssh-open-cluster"@en ;
    skos:altLabel "SSHOC"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ScienceCluster> ;
    skos:definition """network of Research Infrastructures aiming at realising the Social
Sciences and Humanities part of EOSC."""@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "SSH Open Cluster"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/StrategicResearchAndInnovationAgenda> a skos:Concept ;
    dc:source "https://eosc.eu/eosc-about/sria-mar"@en,
        "https://www.eosc.eu/sites/default/files/EOSC-SRIA-V1.0_15Feb2021.pdf"@en ;
    skos:altLabel "SRIA"@en ;
    skos:definition "general framework for future research, development and innovation activities in relation to the European Open Science Cloud"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "Strategic Research and Innovation Agenda"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/StructuralMetadata> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "PREMIS Editorial Committee. (2015). PREMIS Data Dictionary for Preservation Metadata (version 3.0)."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Metadata> ;
    skos:definition "metadata​ that describes the internal structure of ​resources​ and the relationships between their parts."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "structural metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/TechnicalMetadata> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "ISO/TR 14873:2013, modified –– reference to resource instead of digital object."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/AdministrativeMetadata> ;
    skos:definition "administrative metadata​ describing the technical characteristics of a ​resource​."@en ;
    skos:example "Format, size."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "technical metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ThematicEoscNode> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscNode> ;
    skos:definition "EOSC Node representing communities working in a specific scientific domain of research or with specific scientific techniques."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "thematic EOSC Node"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ThematicInfrastructure> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchInfrastructure> ;
    skos:definition "research infrastructure that provides facilities, resources, and services tailored to the needs of a specific scientific domain, research community or thematic area."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "thematic infrastructure"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/TrainingResource> a skos:Concept ;
    dc:source "EOSCFuture project glossary"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Resource> ;
    skos:definition "any resource – including print and non-print materials and online/open-access resources – that supports and enhances, directly or indirectly, learning and teaching."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:note "If a training resource is used in a training environment, for training activities that are part of a training plan and involve instructors, facilitators and students, then we speak of training materials."@en ;
    skos:prefLabel "training resource"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Trl> a skos:Concept ;
    dc:source "https://en.wikipedia.org/wiki/Technology_readiness_level"@en ;
    skos:altLabel "TRL"@en ;
    skos:definition "scale-based method, with scales ranging from 1 (lowest) to 9 (highest), used to estimate the maturity of a technology at a given point during a programme's acquisition or development phase"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "Technology Readiness Level"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/TrustPrinciples> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "Lin, D., Crabtree, J., Dillo, I., Downs, R. R., Edmunds, R., Giaretta, D., Giusti, M. D., L’Hours, H., Hugo, W., Jenkyns, R., Khodiyar, V., Martone, M., Mokrane, M., Navale, V., Petters, J., Sierman, B., Sokolova, D. V., & Stockhause, M. (2019). The TRUST Principles for Digital Repositories — A White Paper (Version 0.03 (draft)). https://docs.google.com/document/d/1pbRw1uf-W-BRMxjj8ZNZJHQTI-ggLjRWq8jiu4Oy6Yc/edit ."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/TrustedDigitalRepository> ;
    skos:definition "set of guidelines to make ​digital repositories​ suitable for data and FAIR digital objects management​ and long-term preservation based on Transparency, Responsibility, User community, Sustainability and Technology (TRUST)."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "TRUST principles"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/VirtualResearchEnvironment> a skos:Concept ;
    dc:source "OSCARS D2.2  - Service Composability Report"@en ;
    skos:altLabel "VRE"@en ;
    skos:definition "environment that allows a researcher to provide/select data and execute a workflow (in a workflow engine)."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "virtual research environment"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Workflow> a skos:Concept ;
    dc:source "OSCARS D2.1 - Clusters' Services and Data Sources Portfolios, p.19; https://zenodo.org/records/14881627"@en ;
    skos:definition "well-defined series of tasks"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "workflow"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/instrument> a skos:Concept ;
    dc:source "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/resourceTypeGeneral/#instrument"@en ;
    skos:definition "device, tool or apparatus used to obtain, measure and/or analyse data"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "instrument"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Access> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources, incl. ESFRI Report on Access to Research Infrastructures and Charter on Access to RIs;     https://zenodo.org/doi/10.5281/zenodo.10533244"@en ;
    skos:definition "protocol for availability of research data and services to users"@en ;
    skos:example "Listed in the Access Charter:  machine time, computing resources, software, data, data-communication services, trust and authentication services, sample preparation, archives, collections, the set-up, execution and dismantling of experiments, education and training, expert support and analytical services"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/OpenAccess> ;
    skos:note "The ESFRI report distinguishes a diversity of access types (physical, remote, virtual) ad nature of services offered. Access policies (open, restricted) is dependent on a range of conditions, including ownership and sensitivity issues."@en ;
    skos:prefLabel "access"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/CertifiedRepository> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Repository> ;
    skos:definition "digital data archive that has been evaluated and approved by an independent authority to meet standards for reliability, data integrity, and long-term preservation."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/TrustedDigitalRepository> ;
    skos:note "Repository certification, such as CoreTrustSeal, offers to any interested data repository a core level certification based on the Core Trustworthy Data Repositories (TDR) requirements."@en ;
    skos:prefLabel "certified repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Component> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources, incl. OSCARS D2.1 - Clusters' Services and Data Sources Portfolios; https://zenodo.org/records/14881627"@en ;
    skos:definition "resource that functions independently but that can be easily assembled or reconfigured with other resources to create new workflows or applications."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:prefLabel "component"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DigitalObject> a skos:Concept ;
    skos:altLabel "DO"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "any kind of digital resource (in particular scholarly objects) made available through network access, interactive databases, software, and workflows."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/FairDigitalObject> ;
    skos:note "A digital object allows to bind all critical information about any entity together, including ​research data​, software, scientific workflows, hardware designs, protocols, provenance logs, publications, presentations, etc., as well as all their ​metadata​ (for the complete object and for its constituents)."@en ;
    skos:prefLabel "digital object"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DomainRepository> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchDataRepository>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/ThematicService> ;
    skos:definition "data repository​ with records for a specific discipline or disciplinary domain"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:prefLabel "domain repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscFederation> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:definition "network of EOSC Nodes that collectively integrate their resources to provide shared system-level functions, known as Federating Capabilities."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscFederationHandbook> ;
    skos:note """The EOSC Federation is a system of systems, built as a
distributed network of services to enable Open Science across disciplinary and national borders."""@en,
        "The Federating Capabilities include a common catalogue for resource discovery, a federated user login system (AAI), and coordinated monitoring."@en ;
    skos:prefLabel "EOSC Federation"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscMember> a skos:Concept ;
    dc:source "EOSC AISBL Statutes, (2020), FINAL. https://www.eoscsecretariat.eu/sites/default/files/eosc_statutes.pdf​."@en,
        "OSCARS Glossary TaskForce 2026, based on several sources; see also https://eosc.eu/members"@en ;
    skos:definition "European ​legal entity​ admitted to the ​EOSC Association​ with full voting rights in the General Assembly."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscMandatedOrganisation> ;
    skos:prefLabel "EOSC Member"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscTripartiteGovernance> a skos:Concept ;
    dc:source "https://eosc.eu/tripartite-collaboration"@en ;
    skos:definition "strategic coordination structure between the EU, represented by the Commission, the EOSC Association, and the Member States and Associated Countries to resource and support the implementation of the EOSC environment in Europe."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscNationalTripartitieEvent> ;
    skos:note "The Member States and Associated Countries are represented by the EOSC Steering Board."@en,
        "The aim is: advancing the Open Science system and aligning national and EU policies to improve the production of FAIR research output."@en ;
    skos:prefLabel "EOSC Tripartite Governance"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EuropeanPartnership> a skos:Concept ;
    dc:source "https://www.era-learn.eu/partnerships-in-a-nutshell/european-partnerships"@en ;
    skos:definition "initiative in which the EU Commission and private and/or public partners commit themselves to jointly support the development and implementation of a research and innovation program."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscPartnership> ;
    skos:prefLabel "European Partnership"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/FairData> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "data​ that conform to the ​FAIR principles​."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/FairPrinciples> ;
    skos:prefLabel "FAIR data"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchInfrastructure> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "Horizon 2020 Work Programme 2018-2020 4. European research infrastructures (including e-Infrastructures), modified — facilities, resources and services are generalised in the infrastructure concept."@en ;
    skos:altLabel "RI"@en ;
    skos:definition "infrastructure enabling the research communities to conduct research and foster innovation in their fields."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/ThematicInfrastructure> ;
    skos:prefLabel "research infrastructure"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchProduct> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:definition """results of scientific work, including  publications,  research
data and research software"""@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/Resource> ;
    skos:prefLabel "research product"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ThematicService> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Resource> ;
    skos:definition "service that provides discipline or domain-specific capabilities for a particular scientific community."@en ;
    skos:example "browsing and downloading data and apps, workflow development and execution, online analytics, result visualisation, sharing of result data"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/DomainRepository> ;
    skos:note "The complement of 'thematic service' is 'generic service'."@en ;
    skos:prefLabel "thematic service"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/TrustedDigitalRepository> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "EOSC Glossary September 2020;"@en ;
    skos:altLabel "TDR"@en,
        "trustworthy digital repository"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/CertifiedRepository> ;
    skos:definition "repository​ certfied according to ISO standard16363 or the CoreTrustSeal Trustworthy Data Repositories requirements."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/TrustPrinciples> ;
    skos:prefLabel "trusted digital repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/DataManagement> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "ISO/IEC TR 10032:2003."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "activities of defining, creating, storing, maintaining and providing access to ​data​ and associated processes in one or more information systems."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/DataManagementPlan>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/DataStewardship> ;
    skos:prefLabel "data management"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscResourceCatalogue> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:definition "catalogue of all EOSC resources, the result of integrating the EOSC service catalogue and the EOSC research product catalogue."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscResearchProductCatalogue>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscServiceCatalogue> ;
    skos:note "The catalogue is hosted by the EU Node and enables the discovery and access of resources provided through EOSC Nodes within the EOSC"@en ;
    skos:prefLabel "EOSC resource catalogue"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Repository> a skos:Concept ;
    dc:source "https://forrt.org/glossary/english/repository/"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Service> ;
    skos:definition "online archive for the storage of digital objects including research outputs, manuscripts, analysis code and/or data."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/CertifiedRepository>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchDataRepository> ;
    skos:note "Repository data may a include wide range of data type, including publications."@en ;
    skos:prefLabel "repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchDataRepository> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Repository> ;
    skos:definition "service supporting the storage, management, preservation, discovery, and access of research datasets and associated metadata to enable research data sharing and reuse."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/DomainRepository>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/GenericRepository> ;
    skos:note "Research data repositories can be generic, institutional, thematic or domain-specific."@en ;
    skos:prefLabel "research data repository"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Service> a skos:Concept ;
    dc:source "EOSCFuture project glossary"@en,
        "https://wiki.en.it-processmaps.com/index.php/ITIL_Glossary/_ITIL_Terms_S"@en ;
    skos:definition "a means of delivering value to customers by facilitating outcomes customers want to achieve without the ownership of specific costs and risks."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/AuthenticationAndAuthorisationInfrastructure>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/Repository> ;
    skos:prefLabel "service"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/AdministrativeMetadata> a skos:Concept ;
    dc:source "EOSC Glossary September 2020"@en,
        "ISO/TR 14873:2013, modified –– reference to metadata instead of information; Note 1 to entry has been broken up into independent concepts; reference to resource instead of digital objects."@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Metadata> ;
    skos:definition "metadata​ necessary to allow the proper management of a ​resource​ in a ​repository​."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/ProvenanceMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/RightsMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/TechnicalMetadata> ;
    skos:note "Administrative metadata can be categorised as ​provenance or context metadata​, ​technical​ and ​rights metadata​."@en ;
    skos:prefLabel "administrative metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/EoscNode> a skos:Concept ;
    dc:source "EOSC Federation Handbook; https://zenodo.org/records/18454649"@en ;
    skos:definition "organisation that complies with the EOSC Federation policies and legal framework, and shares resources at the local, national, regional, thematic or European level."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/EuNode>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/NationalEoscNode>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/ThematicEoscNode> ;
    skos:note "An EOSC Node offers resources that provide added value to the EOSC Federation and implements Federating Capabilities in collaboration with other EOSC Nodes. Each EOSC Node is responsible for its autonomy, governance and resources. It operates its own platform, complying with the EOSC IF technical framework, and the EOSC Node architecture."@en ;
    skos:prefLabel "EOSC Node"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Resource> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchProduct> ;
    skos:definition "digital or physical asset—including services, data, and people—needed to support open science and research"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/HorizontalServices>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/ThematicService>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/TrainingResource> ;
    skos:note "In the context of EOSC, resources are understood to be both digital or analogue. They are produced or operated by or of potential use to researchers. Services include data sources, computational resources and data storage resources."@en ;
    skos:prefLabel "resource"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Metadata> a skos:Concept ;
    dc:source "CODATA RDM Terminology: https://vocabs.ardc.edu.au/repository/api/lda/codata/codata-research-data-management-terminology/current/resource?uri=https://terms.codata.org/rdmt/metadata"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> ;
    skos:definition "data about data that defines and describes the characteristics of other data."@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/AdministrativeMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/DescriptiveMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/PreservationMetadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/StructuralMetadata> ;
    skos:note "Metadata can be categorised as ​descriptive​, ​structural​, ​preservation​ and administrative metadata​."@en ;
    skos:prefLabel "metadata"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/ScienceCluster> a skos:Concept ;
    dc:source "OSCARS Glossary TaskForce 2026, based on several sources"@en ;
    skos:definition "a collaborative framework that brings together research infrastructures from a specific scientific domain to align their capabilities, develop common solutions, and contribute domain-specific resources and services to EOSC"@en ;
    skos:example "ENVRI, ESCAPE, PaNOSC, LS-RI, SSHOC"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/Envri>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/Escape>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/LifeScienceResearchInfrastructure>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/Panosc>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/Sshoc> ;
    skos:note "The five science clusters collaborate under the networlkorganisation known as 'science clusters'."@en ;
    skos:prefLabel "science cluster"@en ;
    skos:topConceptOf <https://vocabs.sshopencloud.eu/vocabularies/oscars/> .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/Data> a skos:Concept ;
    dc:source "https://www.wikidata.org/wiki/Q42848"@en ;
    skos:broader <https://vocabs.sshopencloud.eu/vocabularies/oscars/Component> ;
    skos:definition "codified, fixed and transmissible information, that may be arranged for automatic processing"@en ;
    skos:example "Sequences of bits, code, measurements, text, recordings,"@en ;
    skos:inScheme <https://vocabs.sshopencloud.eu/vocabularies/oscars/> ;
    skos:narrower <https://vocabs.sshopencloud.eu/vocabularies/oscars/DataCuration>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/DataInfrastructure>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/DataLifeCycle>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/DataManagement>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/DigitalData>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/DigitalObject>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/FairData>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/Metadata>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/OpenData>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/PersonalData>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/RawData>,
        <https://vocabs.sshopencloud.eu/vocabularies/oscars/ResearchData> ;
    skos:note "In the ​EOSC ecosystem​ (research) data can be digital, analogue or heterogenous in nature."@en ;
    skos:prefLabel "data"@en .

<https://vocabs.sshopencloud.eu/vocabularies/oscars/> a skos:ConceptScheme ;
    dc:creator "OSCARS Glossaries Task Force"@en ;
    dc:description """The vocabulary defines concepts frequently used within the OSCARS project, the five science clusters that initiated the project, and the wider EOSC ecosystem.
