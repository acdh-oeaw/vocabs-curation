<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:dct="http://purl.org/dc/terms/"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <skos:ConceptScheme rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/">
        <dct:title xml:lang="de">Textgenetisches Glossar</dct:title>
        <rdfs:label>Textgenetisches Glossar</rdfs:label>
        <dct:contributor>Ingo Börner</dct:contributor>
        <dct:contributor>Isabella Schwentner</dct:contributor>
        <dct:publisher>ACDH – Austrian Centre for Digital Humanities</dct:publisher>
        <dct:language>German</dct:language>
        <dct:subject xml:lang="de">Editionswissenschaft</dct:subject>
        <dct:subject xml:lang="de">critique génétique</dct:subject>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293–300.</dct:source>
        <dct:hasVersion>1.0</dct:hasVersion>
    </skos:ConceptScheme>

    
    <!-- Dossier génétique --> <!-- Avant-texte -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K036">
        <skos:prefLabel xml:lang="de">Dossier génétique</skos:prefLabel>
        <skos:altLabel xml:lang="de">Avant-texte</skos:altLabel>
        <skos:note xml:lang="de">chronologisch geordneter Komplex aller schriftlich überlieferten
            textgenetischen Zeugen eines Werkes bzw. Gesamtheit aller überlieferten und chronologisch geordneten
                schriftlichen Zeugen zur Genese eines (vollendeten oder unvollendeten)
                Werkes.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S. 293 u.
            294.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <!-- Allograph -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K003">
        <skos:prefLabel xml:lang="de">Allograph</skos:prefLabel>
        <skos:note xml:lang="de">von anderer Hand als der des Autors geschrieben.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293.</dct:source>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K006"/>
        <skos:editorialNote xml:lang="de">Gegenteil: Autograph</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Arbeitshandschrift -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K004">
        <skos:prefLabel xml:lang="de">Arbeitshandschrift</skos:prefLabel>
        <skos:note xml:lang="de">eine Handschrift, die unverkennbar zur Phase der Textausarbeitung,
            zur Niederschrift des Textes gehört;</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293.</dct:source>
        <skos:editorialNote xml:lang="de">Verweis zu Brouillon; enthalten in Erklärung von Textabfassungs- oder Textualisierungsphase</skos:editorialNote>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K022"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    

    <!-- Ausgabe letzter Hand -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K005">
        <skos:prefLabel xml:lang="de">Ausgabe letzter Hand</skos:prefLabel>
        <skos:note xml:lang="de">letzte vom Autor durchgesehene, korrigierte und autorisierte
            Fassung, die der kritischen Ausgabe zugrunde gelegt wird.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293.</dct:source>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K068"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Autoggraph -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K006">
        <skos:prefLabel xml:lang="de">Autograph</skos:prefLabel>
        <skos:note xml:lang="de">vom Autor eigenhändig geschriebenes Schriftstück; im Gegensatz zu
            Dokumenten, die von Sekretären, Schreibern oder Kopisten geschrieben sind.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293.</dct:source>
        <skos:editorialNote xml:lang="de">Gegenteil: Allograph</skos:editorialNote>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K003"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Betagraphie -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K007">
        <skos:prefLabel xml:lang="de">Betagraphie</skos:prefLabel>
        <skos:note xml:lang="de">Reproduktionstechnik, bei der nur Siebmerkmale und Wasserzeichen
            des Papiers, nicht aber die Schriftzüge selbst reproduziert werden.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Blatt -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K008">
        <skos:prefLabel xml:lang="de">Blatt</skos:prefLabel>
        <skos:note xml:lang="de">gängige Bezeichnung für Schriftträger aus Papier; ein Blatt kann
            von sehr unterschiedlichem Format sein; es besitzt zwei Seiten, die Vorder- und die
            Rückseite (auch als recto und verso bezeichnet); ein Handschriftenkonvolut enthält eine
            bestimmte Anzahl von Blättern, die einseitig oder beidseitig beschriftet sind. Jedem
            Blatt wird bei der Archivierung eine Folionummer (Foliierung) zugeordnet.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <!-- recto -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K010">
        <skos:prefLabel xml:lang="de">recto</skos:prefLabel>
        <skos:altLabel xml:lang="de">Blattvorderseite</skos:altLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Blatt</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- verso -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K011">
        <skos:prefLabel xml:lang="de">verso</skos:prefLabel>
        <skos:altLabel xml:lang="de">Blattrückseite</skos:altLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Blatt</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Handschriftenkonvolut -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K012">
        <skos:prefLabel xml:lang="de">Handschriftenkonvolut</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Blatt</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Archivierung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K013">
        <skos:prefLabel xml:lang="de">Archivierung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Blatt</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Folionummer -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K014">
        <skos:prefLabel xml:lang="de">Folionummer</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Blatt</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Bogen -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K015">
        <skos:prefLabel xml:lang="de">Bogen</skos:prefLabel>
        <skos:note xml:lang="de">Papiereinheit im "Rohzustand", d.h. in der Größe, wie das Papier
            aus der Presse kommt. Erst durch ein- oder mehrmaliges Falten entsteht das Blattformat;
            ohne Faltung: Planoformat; einmalige Faltung: Folio; zweimalige Faltung: Quart;
            dreimalige Faltung: Oktav.</skos:note>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Format -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K016">
        <skos:prefLabel xml:lang="de">Format</skos:prefLabel>
        <skos:altLabel xml:lang="de">Blattformat</skos:altLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Bogen</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K018"/>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K019"/>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K020"/>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K021"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Faltung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K017">
        <skos:prefLabel xml:lang="de">Faltung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Bogen</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- plano -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K018">
        <skos:prefLabel xml:lang="de">Plano</skos:prefLabel>
        <skos:altLabel xml:lang="de">Plano-Format</skos:altLabel>
        <skos:note xml:lang="de">(ohne Faltung)</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Bogen</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K016"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- folio -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K019">
        <skos:prefLabel xml:lang="de">Folio</skos:prefLabel>
        <skos:altLabel xml:lang="de">Folio-Format</skos:altLabel>
        <skos:note xml:lang="de">(einmalige Faltung)</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Bogen</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K016"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- quart -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K020">
        <skos:prefLabel xml:lang="de">Quart</skos:prefLabel>
        <skos:altLabel xml:lang="de">Quart-Format</skos:altLabel>
        <skos:note xml:lang="de">(zweimalige Faltung)</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Bogen</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K016"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- oktav -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K021">
        <skos:prefLabel xml:lang="de">Oktav</skos:prefLabel>
        <skos:altLabel xml:lang="de">Oktav-Format</skos:altLabel>
        <skos:note xml:lang="de">(dreimalige Faltung)</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Bogen</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K016"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Brouillon -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K022">
        <skos:prefLabel xml:lang="de">Brouillon</skos:prefLabel>
        <skos:note xml:lang="de">mit Streichungen, Zusätzen und Um-Schreibungen übersätes
            Blatt</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293.</dct:source>
        <skos:editorialNote xml:lang="de">Verweis zu Arbeitshandschrift; Begriff verwendet in der Erläuterung zu "Produktorientiertes Schreiben", "Textabfassungs- oder
            Textualisierungsphase" und "Textgenetische Phase"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
   

    <!-- Buchrolle -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K025">
        <skos:prefLabel xml:lang="de">Buchrolle</skos:prefLabel>
        <skos:note xml:lang="de">im Laufe des 2. Jahrhunderts v. Chr. erfundener Schriftträger in
            Form einer Rolle aus Papyrus oder Pergament; nach einer langen Übergangsphase
            schließlich ganz vom Kodex abgelöst.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


  
    <!-- Critique génétique -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K030">
        <skos:prefLabel xml:lang="de">Critique génétique</skos:prefLabel>
        <skos:note xml:lang="de">Rekonstruktion und Interpretation literarischer Schreibprozesse
            anhand von schriftlich überliefertem Entstehungsmaterial.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Daktylogramm -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K031">
        <skos:prefLabel xml:lang="de">Typoskript</skos:prefLabel>
        <skos:altLabel xml:lang="de">Daktylogramm</skos:altLabel>
        <skos:note xml:lang="de">maschinengeschriebenes Schriftstück; innerhalb einer Textgenese im
            allgemeinen gegen Ende des Schreibprozesses angesiedelt; kann vom Autor oder einer
            anderen Person angefertigt sein.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    
    <!-- Schriftstück -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K032">
        <skos:prefLabel xml:lang="de">Schriftstück</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Daktylogramm</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Entstehungsmaterial -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K035">
        <skos:prefLabel xml:lang="de">Entstehungsmaterial</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Critique génétique</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Diplomatische Transkription -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K038">
        <skos:prefLabel xml:lang="de">Diplomatische Transkription</skos:prefLabel>
        <skos:note xml:lang="de">ursprünglich, im Kontext mittelalterlicher Handschriften, eine den
            Wortlaut treu wiedergebende Umschrift einer Urkunde; im Rahmen der "critique génétique"
            maschinenschriftliche oder gedruckte Wiedergabe einer Handschrift, die sich strikt an
            die Topographie des beschriebenen Raumes einer Seite hält: jedes Schriftzeichen
            erscheint an derselben Stelle der Seite wie auf dem Original. Insbesondere Randnotizen,
            Streichungen und interlineare Einfügungen müssen als solche auch in der Transkription
            visuell erkennbar sein.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <!-- Topographie des beschriebenen Raumes -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K042">
        <skos:prefLabel xml:lang="de">Topographie</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Diplomatische Transkription" u. "Linearisierte Transkription"</skos:editorialNote>
        <skos:scopeNote>Topographie des beschriebenen Raumes, Topographie der Seite</skos:scopeNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <!-- maschinenschriftliche Wiedergabe -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K040">
        <skos:prefLabel xml:lang="de">maschinenschriftliche Wiedergabe</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Diplomatische
            Transkription</skos:editorialNote>
        <skos:related rdf:reesource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K041"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- gedruckte Wiedergabe -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K041">
        <skos:prefLabel xml:lang="de">gedruckte Wiedergabe</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Diplomatische
            Transkription</skos:editorialNote>
        <skos:related rdf:reesource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K040"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    

    <!-- Randnotiz -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K043">
        <skos:prefLabel xml:lang="de">Randnotiz</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Diplomatische
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K045">
        <skos:prefLabel xml:lang="de">interlineare Einfügung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Diplomatische
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Druckvorlage -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K046">
        <skos:prefLabel xml:lang="de">Druckvorlage</skos:prefLabel>
        <skos:note xml:lang="de">die Fassung, die der Autor als Vorlage für den Druck bestimmt; je
            nachdem kann es sich um eigenhändige Reinschriften, um Abschriften von Schreiberhand, um
            maschinenschriftliche Abschriften oder Computerausdrucke handeln.</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibprozeß</skos:editorialNote>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- eigenhändige Reinschrift -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K048">
        <skos:prefLabel xml:lang="de">eigenhändige Reinschrift</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Druckvorlage</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Abschrift von Schreiberhand -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K049">
        <skos:prefLabel xml:lang="de">Abschrift von Schreiberhand</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Druckvorlage</skos:editorialNote>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K003"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- maschinenschriftliche Abschrift -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K050">
        <skos:prefLabel xml:lang="de">maschinenschriftliche Abschrift</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Druckvorlage</skos:editorialNote>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K031"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Computerausdruck -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K051">
        <skos:prefLabel xml:lang="de">Computerausdruck</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Druckvorlage</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Duktus -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K052">
        <skos:prefLabel xml:lang="de">Duktus</skos:prefLabel>
        <skos:note xml:lang="de">persönliche Note von Schriftzügen; am Duktus erkennt man eine
            Handschrift als von einem bestimmten Autor stammend; je nach physischer und psychischer
            Verfassung des Schreibers kann der Duktus gewissen Veränderungen
            unterliegen.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


 
    <!-- Handschrift (Schriftzüge) ? -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K054">
        <skos:prefLabel xml:lang="de">Handschrift (Schriftzüge) ?</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Duktus</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Einfügungszeichen -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K055">
        <skos:prefLabel xml:lang="de">Einfügungszeichen</skos:prefLabel>
        <skos:note xml:lang="de">metaschriftliches Zeichen, das die Stelle kennzeichnet, an der
            nachträglich eine sprachliche Einheit eingefügt wird.</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Graphischer
            Signifikant</skos:editorialNote>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K057"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <!-- metaschriftliches Zeichen -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K057">
        <skos:prefLabel xml:lang="de">metaschriftliches Zeichen</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung von "Einfügungszeichen" u. "Graphischer Signifikant"</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K055"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <!-- Entwurf -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K058">
        <skos:prefLabel xml:lang="de">Entwurf</skos:prefLabel>
        <skos:altLabel xml:lang="fr">ébauche</skos:altLabel>
        <skos:note xml:lang="de">frühe, grobe, aber schon strukturierte Form des entstehenden
            Werkes; verwandte textgenetische Stadien: Plan, Skizze, Szenario.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:editorialNote xml:lang="de">Enthalten in der Erläuterung zu "Schreibvorbereitungsphase", "Textgenetische Phase" u. "Skizze".</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K059"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- textgenetisches Stadium -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K059">
        <skos:prefLabel xml:lang="de">textgenetisches Stadium</skos:prefLabel>
        <skos:altLabel xml:lang="de">Stadium der Textentstehung</skos:altLabel>
        <skos:altLabel xml:lang="de">Stadium einer Textgenese</skos:altLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Entwurf", "Überarbeitung", "Kollationieren" u. "Fassung"</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K058"/>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K060"/>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K269"/>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K062"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <!-- Plan -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K060">
        <skos:prefLabel xml:lang="de">Plan</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Entwurf", "Produktorientiertes Schreiben", "Prozessorientiertes Schreiben", "Schreibvorbereitungsphase" u. "Textgenetische Phase".</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K059"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
 
    

    <!-- Szenario -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K062">
        <skos:prefLabel xml:lang="de">Szenario</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Entwurf</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K059"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Entzifferung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K063">
        <skos:prefLabel xml:lang="de">Entzifferung</skos:prefLabel>
        <skos:note xml:lang="de">Lektürevorgang, bei dem der Textgenetiker den handschriftlichen
            Befund der genetischen Dokumente identifiziert und aufschlüsselt; der Schwierigkeitsgrad
            hängt von der jeweiligen Handschrift als solcher ab (Leserlichkeit bzw. Unleserlichkeit
            einer Handschrift), von der Anzahl der Streichungen, vom Zustand der Konservierung
            (Tinte kann leicht verblassen, Bleistift kann abgerieben werden) usw.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Textgenetiker -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K064">
        <skos:prefLabel xml:lang="de">Textgenetiker</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Entzifferung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Befund -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K065">
        <skos:prefLabel xml:lang="de">Befund</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Entzifferung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Zustand der Konservierung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K067">
        <skos:prefLabel xml:lang="de">Zustand der Konservierung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Entzifferung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Erstausgabe -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K068">
        <skos:prefLabel xml:lang="de">Erstausgabe</skos:prefLabel>
        <skos:note xml:lang="de">erste gedruckte Fassung eines Werkes.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K005"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Ersetzung --> <!-- Substitution -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K071">
        <skos:prefLabel xml:lang="de">Ersetzung</skos:prefLabel>
        <skos:altLabel xml:lang="de">Substitution</skos:altLabel>
        <skos:note xml:lang="de">Schreibvorgang, durch den ein Segment durch ein anderes ersetzt
            wird.</skos:note>
        <!-- 
        <skos:note xml:lang="de">Schreibakt, durch den man ein Segment streicht und durch ein
            anderes ersetzt. Synonym: Ersetzung</skos:note>-->
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294 u. 298.</dct:source>
        <skos:editorialNote xml:lang="de">Synonym: Substitution; enthalten in der Erläuterung zu "Streichung", "Substitution", "Zwischenzeiliger Raum"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K379"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
  
    <!-- Schreibvorgang -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K072">
        <skos:prefLabel xml:lang="de">Schreibvorgang</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Schreibphase", "Um-Schreibung", "Lesevariante"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <!-- Erweiterung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K074">
        <skos:prefLabel xml:lang="de">Erweiterung</skos:prefLabel>
        <skos:altLabel xml:lang="fr">ajout</skos:altLabel>
        <skos:note xml:lang="de">semantische und syntaktische Bereicherung durch Einfügen
            ergänzender Wörter, Syntagmen oder Sätze; Beispiel: "seine Hand" wird erweitert zu
            "seine weiße Hand".</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Zwischenzeiliger Raum</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K379"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <!-- Faksimile -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K075">
        <skos:prefLabel xml:lang="de">Faksimile</skos:prefLabel>
        <skos:note xml:lang="de">Drucktechnik, die die wesentlichen Eigenschaften des Originals
            wahrt; Ende des 18. Jahrhunderts als "Lithographie" erfunden; im 19. Jahrhundert von der
            Fotographie, im 20. Jahrhundert von Mikrofilm, Fotokopie und Scanner
            abgelöst.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Drucktechnik -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K076">
        <skos:prefLabel xml:lang="de">Drucktechnik</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Faksimile</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Original -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K077">
        <skos:prefLabel xml:lang="de">Original</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Faksimile" u. "Linearisierte Transkription".</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Fassung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K078">
        <skos:prefLabel xml:lang="de">Fassung</skos:prefLabel>
        <skos:note xml:lang="de">relativ fortgeschrittenes Stadium einer Textgenese; es kann mehrere
            handschriftliche und / oder mehrere gedruckte Fassungen ein und desselben Textes
            geben.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Variante" u. "Druckvorlage"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <!-- Text -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K080">
        <skos:prefLabel xml:lang="de">Text</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Fassung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Foliierung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K081">
        <skos:prefLabel xml:lang="de">Foliierung</skos:prefLabel>
        <skos:note xml:lang="de">Vorgang des Foliierens, d.h. jedes Blatt wird oben rechts auf der
            Vorderseite mit einer Ziffer versehen, durch die es sich im archivalischen Sinn
            identifizieren läßt.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Freie Variante -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K082">
        <skos:prefLabel xml:lang="de">Freie Variante</skos:prefLabel>
        <skos:note xml:lang="de">Umformulierung, die nicht von grammatikalischen (morphologischen,
            syntaktischen oder orthographischen) Regeln abhängt.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K085">
        <skos:prefLabel xml:lang="de">Gebundene Variante</skos:prefLabel>
        <skos:note xml:lang="de">Umformulierung, die an grammatikalische Gesetzmäßigkeiten der
            Sprache gebunden ist (Korrektur) oder das Ergebnis einer freien Variante auf den Rest
            des Satzes überträgt (In freier Variante wird das Subjekt des Satzes "Das Haus ist
            klein" erweitert zu "Das Haus und der Garten"; daraus folgt zwangsläufig eine gebundene
            Variante, nämlich die Korrektur von "ist" zu "sind").</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K088">
        <skos:prefLabel xml:lang="de">Genetische Ausgabe</skos:prefLabel>
        <skos:note xml:lang="de">Ausgabe, die in gedruckter Form und in der chronologischen
            Reihenfolge des Schreibprozesses alle überlieferten textgenetischen Dokumente eines
            Werkes oder eines Werkfragments vorstellt; Beispiel: die genetische Ausgabe von Un cæur
            simple von Flaubert, Hrsg. G. Bonaccorso (siehe Bibliogrphie).</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K090">
        <skos:prefLabel xml:lang="de">Graphischer Signifikant</skos:prefLabel>
        <skos:note xml:lang="de">Basiseinheit des Schreibens; die Gesamtheit aller graphischen
            Signifikaten umfaßt einerseits die Buchstaben des Alphabets, andererseits
            Interpunktionszeichen und metaschriftliche Zeichen (Einfügungszeichen, Verweiszeichen,
            Durchstreichungsstriche, Farbstriche usw.).</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K091">
        <skos:prefLabel xml:lang="de">Interpunktionszeichen</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Graphischer
            Signifikant</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K094">
        <skos:prefLabel xml:lang="de">Verweiszeichen</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Graphischer
            Signifikant</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


<!-- Durchstreichungsstrich -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K095">
        <skos:prefLabel xml:lang="de">Durchstreichungsstrich</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Graphischer Signifikant" u. "Tilgung"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K096">
        <skos:prefLabel xml:lang="de">Farbstrich</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Graphischer
            Signifikant</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K097">
        <skos:prefLabel xml:lang="de">Handschrift 1</skos:prefLabel>
        <skos:note xml:lang="de">jedes von Hand geschriebene Dokument.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Diplomatische
            Transkription?</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K098">
        <skos:prefLabel xml:lang="de">Handschrift 2</skos:prefLabel>
        <skos:note xml:lang="de">persönlich geprägte Form von Schriftzügen ("Er schickte mir einen
            Brief, geschrieben in seiner unveränderlich schönen Handschrift.").</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K099">
        <skos:prefLabel xml:lang="de">Heft</skos:prefLabel>
        <skos:note xml:lang="de">zusammengeheftete Blätter; dient häufig zur Textausarbeitung
            (Beispiel: die Hefte von Proust), aber auch zum Festhalten von Gedankenfragmenten
            (Beispiel: Hefte von Valéry); unterscheidet sich von losen Blättern sowie vom
            Notizbuch</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K100">
        <skos:prefLabel xml:lang="de">loses Blatt</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Heft</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K102">
        <skos:prefLabel xml:lang="de">Hypertext</skos:prefLabel>
        <skos:note xml:lang="de">ein Netz miteinander verbundener schriftlicher Dokumente;
            verschiedene textgenetische Dokumente können hypertextartig miteinander vernetzt
            werden.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K104">
        <skos:prefLabel xml:lang="de">Imprimatur</skos:prefLabel>
        <skos:note xml:lang="de">Unterschrift, durch die der Autor die Druckerlaubnis für seinen
            Text erteilt; mit dieser Unterschrift verläßt der Text definitiv die Privatsphäre des
            Schreibens und geht in den Bereich des Öffentlichen ein, den des veröffentlichten
            Buches.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K105">
        <skos:prefLabel xml:lang="de">Incipit</skos:prefLabel>
        <skos:note xml:lang="de">Anfang eines Textes, aber auch eines Schreibprozesses; beide fallen
            nicht zwangsläufig zusammen.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


<!-- RAUM -->

    
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K208">
        <skos:prefLabel xml:lang="de">Schreibraum</skos:prefLabel>
        <skos:altLabel xml:lang="de">Raum</skos:altLabel>
        <skos:note xml:lang="de">Raum der Seite, auf der sich unbeschriebene Stellen und
            beschriebene abwechseln; das Verhältnis zwischen beschriebenem und nicht beschriebenem
            Raum ist im Fall von Buchseiten konstant, im Fall von Handschriftenseiten
            variabel.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Zwischenzeiliger Raum" und "Interlinearer Raum"</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K106"/> <!-- interlinearer Raum -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K211"/> <!-- nicht beschriebener Raum -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K189"/> <!-- beschriebener Raum -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <!-- nicht beschriebener Raum -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K211">
        <skos:prefLabel xml:lang="de">nicht beschriebener Raum</skos:prefLabel>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K189"/>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibraum</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K208"/> <!-- Schreibraum -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K187"/> <!-- Rand -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>    

<!-- Interlinearer Raum -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K106">
        <skos:prefLabel xml:lang="de">Interlinearer Raum</skos:prefLabel>
        <skos:altLabel xml:lang="de">Zwischenzeiliger Raum</skos:altLabel>
        <skos:note xml:lang="de">Schreibraum, der zwei beschriebene Zeilen voneinander trennt, aber
            auch selbst Geschriebenes aufnehmen kann; vornehmlich Erweiterungen oder Ersetzungen für
            durchgestrichene Einheiten. Synonym: interlinearer Raum.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295 u. 300.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Zwischenzeiliger Raum" u. "Lesevariante"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K208"/> <!-- Schreibraum Raum -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    
    <!-- beschriebener Raum -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K189">
        <skos:prefLabel xml:lang="de">beschriebener Raum</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Rand" und "Schreibraum"</skos:editorialNote>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K211"/> <!-- nicht beschriebener Raum -->
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K208"/> <!-- Schreibraum -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K374"/> <!-- Zeile -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <!-- Zeile -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K374">
        <skos:prefLabel xml:lang="de">Zeile</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Zwischenzeiliger Raum</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K189"/> <!-- beschriebener Raum -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    
    <!-- Rand -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K187">
        <skos:prefLabel xml:lang="de">Rand</skos:prefLabel>
        <skos:note xml:lang="de">bei Büchern: unbeschriebener graphischer Raum, der den
            beschriebenen Raum der Seite umgibt und damit den sogenannten Satzspiegel festlegt; bei
            genetischen Dokumenten kann der Rand beschrieben werden: er ist einerseits eine Art
            Gedankenspeicher, bietet aber auch Raum für metaschriftliche Notizen, Varianten
            usw.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Lesevariante</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K211"/> <!-- nicht beschriebener Raum -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K188">
        <skos:prefLabel xml:lang="de">graphischer Raum</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Rand</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

<!-- /RAUM -->

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K108">
        <skos:prefLabel xml:lang="de">Kodex</skos:prefLabel>
        <skos:altLabel>codex</skos:altLabel>
        <skos:note xml:lang="de">handgeschriebenes Buch in seiner frühesten Form; seine Erfindung in
            den ersten Jahrhunderten n. Chr. kennzeichnet den allmählichen Übergang von der
            Buchrolle (oder Rolle) zur Form des gebundenen Buches.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Buchrolle</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K109">
        <skos:prefLabel xml:lang="de">Kollationieren</skos:prefLabel>
        <skos:note xml:lang="de">zwei textgenetische Stadien oder zwei gedruckte Fassungen eines
            Textes miteinander vergleichen und deren Unterschiede festhalten.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K111">
        <skos:prefLabel xml:lang="de">Konjektur</skos:prefLabel>
        <skos:note xml:lang="de">nicht eindeutig abgesicherte Lesart einer Handschrift.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>





    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K115">
        <skos:prefLabel xml:lang="de">sprachlicher Fehler</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Korrektur</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K116">
        <skos:prefLabel xml:lang="de">Schreibfehler</skos:prefLabel>
        <skos:altLabel>Lapsus</skos:altLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Korrektur</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


<!-- Korrekturfahne -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K117">
        <skos:prefLabel xml:lang="de">Korrekturfahne</skos:prefLabel>
        <skos:note xml:lang="de">erste, noch ohne Seitenumbruch gedruckte Form eines Textes, die dem
            Autor normalerweise zum "Korrekturlesen" vorgelegt wird.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Textgenetische Phase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K118">
        <skos:prefLabel xml:lang="de">Seitenumbruch</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Korrekturfahne</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K119">
        <skos:prefLabel xml:lang="de">Korrekturlesen</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Korrekturfahne</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K120">
        <skos:prefLabel xml:lang="de">Kritischer Apparat</skos:prefLabel>
        <skos:note xml:lang="de">der Teil einer kritischen Edition, der die Entstehungsgeschichte
            und die Überlieferung eines Textes, den Herausgeberbericht, den Variantenapparat sowie
            Auszüge aus anderen Fassungen eines Textes usw. enthält.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


<!-- Kritische Edition -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K121">
        <skos:prefLabel xml:lang="de">Kritische Edition</skos:prefLabel>
        <skos:altLabel xml:lang="de">Kritische Ausgabe</skos:altLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Kritischer Apparat" und "Variante"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    <!-- Entstehungsgeschichte -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K122">
        <skos:prefLabel xml:lang="de">Entstehungsgeschichte</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Kritischer Apparat</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Überlieferung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K123">
        <skos:prefLabel xml:lang="de">Überlieferung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Kritischer Apparat</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Herausgeberbericht -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K124">
        <skos:prefLabel xml:lang="de">Herausgeberbericht</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Kritischer Apparat</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


<!-- Variantenapparat -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K125">
        <skos:prefLabel xml:lang="de">Variantenapparat</skos:prefLabel>
        <skos:editorialNote xml:lang="de">Enthalten in der Erläuterung zu "Kritischer Apparat" u. "Variante"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

<!-- Lesenotizen -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K126">
        <skos:prefLabel xml:lang="de">Lesenotizen</skos:prefLabel>
        <skos:note xml:lang="de">Exzerpte aus gelesenem Quellenmaterial; häufig auf Karteikarten
            oder in Notizheften überliefert.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:editorialNote xml:lang="de">enthlaten in der Erläuterung zu "Produktorientiertes Schreiben" u. "Schreibvorbereitungsphase"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
   

<!-- Platz -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K130">
        <skos:prefLabel xml:lang="de">Platz</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Lesevariante" und "Umstellung"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K136">
        <skos:prefLabel xml:lang="de">Lesart</skos:prefLabel>
        <skos:altLabel xml:lang="fr">leçon</skos:altLabel>
        <skos:note xml:lang="de">Ergebnis des Entzifferns ("es gibt mehrere Lesarten zu dieser
            Stelle").</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Konjektur</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K137">
        <skos:prefLabel xml:lang="de">Linearisierte Transkription</skos:prefLabel>
        <skos:note xml:lang="de">maschinenschriftliche Wiedergabe einer Handschrift, die alle
            Elemente des Originals überträgt, jedoch ohne sich an die Topographie der Seite zu
            halten. An deren Stelle tritt häufig eine Chronologisierung der Schreibelemente. Damit
            ist der erste Schritt in Richtung Interpretation getan, denn die Vertikalität der
            Umformungsparadigmen wird auf horizontal-syntagmatische Sequenzen übertragen, und dies
            ist nur möglich, idem räumliche Indizien in zeitliche Kriterien, d.h. in Aussagen über
            die Genese des Werkes überführt werden.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K140">
        <skos:prefLabel xml:lang="de">Chronologisierung der Schreibelemente</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Linearisierte
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K141">
        <skos:prefLabel xml:lang="de">Interpretation</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Linearisierte
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K142">
        <skos:prefLabel xml:lang="de">Vertikalität der Umformulierungsparadigmen</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Linearisierte
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K143">
        <skos:prefLabel xml:lang="de">Umformulierungsparadigma</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Linearisierte
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K144">
        <skos:prefLabel xml:lang="de">horizontal-syntagmatische Sequenz</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Linearisierte
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K145">
        <skos:prefLabel xml:lang="de">Indiz</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Linearisierte
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K146">
        <skos:prefLabel xml:lang="de">räumliches Indiz</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Linearisierte
            Transkription</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K147">
        <skos:prefLabel xml:lang="de">Materielle Beschreibung</skos:prefLabel>
        <skos:note xml:lang="de">Vorgang, bei dem die materiellen Merkmale einer Handschrift (oder
            des Konvoluts von Handschriften) erfaßt werden: Autograph oder Allograph, Kennzeichen
            der Schrift, Farbe und Format des Schriftträgers, Typ des Papiers und der Wasserzeichen,
            ein- oder beidseitig beschrieben, Anzahl der Blätter, Beschaffenheit und Farbe des
            Schreibwerkzeugs (Bleistift, Tinte).</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K148">
        <skos:prefLabel xml:lang="de">materielles Merkmal</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Materielle
            Beschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K149">
        <skos:prefLabel xml:lang="de">Konvolut</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Materielle
            Beschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K152">
        <skos:prefLabel xml:lang="de">Metaschriftlich</skos:prefLabel>
        <skos:note xml:lang="de">charakterisiert jedes geschriebene Zeichen, dessen Inhalt sich auf
            den Schreibakt selbst, die Bedingungen der Textherstellung und die Arbeit des
            schriftlichen Formulierens bezieht.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


<!-- Schreibakt -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K153">
        <skos:prefLabel xml:lang="de">Schreibakt</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Metaschriftlich" und "Schreibprozeß"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K154">
        <skos:prefLabel xml:lang="de">Textherstellung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Metaschriftlich</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K155">
        <skos:prefLabel xml:lang="de">Moderne Kodikologie</skos:prefLabel>
        <skos:note xml:lang="de">Hilfswissenschaft, die die moderne Handschrift als materiellen und
            historischen Gegenstand untersucht: Schriftträger, Schreibwerkzeuge und Schreibspuren;
            Geschichte der Handschriftenbestände, Verzeichnisse und Kataloge.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



<!-- Notizbuch -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K158">
        <skos:prefLabel xml:lang="de">Notizbuch</skos:prefLabel>
        <skos:note xml:lang="de">Schriftträger von kleinem Format und Umfang; dient sowohl zum
            Festhalten von Gedanken oder biographischen Einzelheiten wie von Notizen zu entstehenden
            Werken; Beispiel: die Notizbücher von Flaubert.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Heft</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K159">
        <skos:prefLabel xml:lang="de">Umfang</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Notizbuch</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K160">
        <skos:prefLabel xml:lang="de">Paläographie</skos:prefLabel>
        <skos:note xml:lang="de">Wissenschaft von den Schriften des Altertums (orientalisch,
            griechisch, lateinisch) und dem Substrat dieser Schriften; 1708 von Montfaucon
            geschaffener Begriff.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Papier -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K161">
        <skos:prefLabel xml:lang="de">Papier</skos:prefLabel>
        <skos:note xml:lang="de">auf der Grundlage verschiedener Stoffe hergestellter Schriftträger;
            an die Stelle des handgeschöpften Papiers ("Büttenpapier") ist in der zweiten Hälfte des
            19. Jahrhunderts das maschinell hergestellte Papier getreten.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Schriftträger" u. "Wasserzeichen"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    


    <!-- Papyrus -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K163">
        <skos:prefLabel xml:lang="de">Papyrus</skos:prefLabel>
        <skos:note xml:lang="de">aus dem Mark der Papyrosstaude in Ägypten hergestellter
            Schriftträger</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Buchrolle" u. "Schriftträger"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K165">
        <skos:prefLabel xml:lang="de">Paradigma</skos:prefLabel>
        <skos:note xml:lang="de">Reihe von sprachlichen Einheiten, die zu derselben syntaktischen
            Kategorie gehören und bei Schreibprozessen untereinander durch semantische Beziehungen
            verbunden sind; ein Substitutionsparadigma stellt eine Reihe von Umformulierungen einer
            Schreibeinheit dar; ein paradigmatisches Ensemble erscheint vertikal im horizontalen
            Verlauf der syntagmatischen Linearität eines "avant-texte".</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K168">
        <skos:prefLabel xml:lang="de">syntaktische Kategorie</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Paradigma</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K169">
        <skos:prefLabel xml:lang="de">semantische Beziehung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Paradigma</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K170">
        <skos:prefLabel xml:lang="de">Substitutionsparadigma</skos:prefLabel>
        <skos:note xml:lang="de">(ein Substitutionsparadigma stellt eine Reihe von Umformulierungen
            einer Schreibeinheit dar;)</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Paradigma</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K171">
        <skos:prefLabel xml:lang="de">paradigmatisches Ensemble</skos:prefLabel>
        <skos:note xml:lang="de">ein paradigmatisches Ensemble erscheint vertikal im horizontalen
            Verlauf der syntagmatischen Linearität eines "avant-texte"</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Paradigma</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K172">
        <skos:prefLabel xml:lang="de">Pergament</skos:prefLabel>
        <skos:note xml:lang="de">aus Tierhäuten bestehender Schriftträger, der zuerst im
            kleinasiatischen Pergamon hergestellt wurde.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Buchrolle" u. "Schriftträger"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

  

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K174">
        <skos:prefLabel xml:lang="de">Schreibelement</skos:prefLabel>
        <skos:note xml:lang="de">(Wörter, Sätze, Abschnitte oder ganze Kapitel)</skos:note>
        <skos:editorialNote xml:lang="de">aus der note zu Permutation; könnte auch Segment gemeint
            sein</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K175">
        <skos:prefLabel xml:lang="de">Produktorientiertes Schreiben</skos:prefLabel>
        <skos:note xml:lang="de">Schreibtyp, der einem vorher aufgestellten Plan konsequent folgt
            und dessen Ausführung oft mehrere textgenetische Phasen durchläuft (Lesenotizen, Pläne,
            Listen, Skizzen, Brouillons); Beispiel: Zola.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K176"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K176">
        <skos:prefLabel xml:lang="de">Schreibtyp</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Produktorientiertes Schreiben" u. "Prozeßorientiertes Schreiben"</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K175"/>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K183"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K183">
        <skos:prefLabel xml:lang="de">Prozeßorientiertes Schreiben</skos:prefLabel>
        <skos:note xml:lang="de">Schreibtyp ohne Vorbereitungsphase und ohne Plan; der Text entsteht
            beim Schreiben selbst; Beispiel: Proust.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K176"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>




    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K185">
        <skos:prefLabel xml:lang="de">Vorbereitungsphase</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Prozeßorientiertes
            Schreiben</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

  

<!-- Satz -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K191">
        <skos:prefLabel xml:lang="de">Satzspiegel</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Rand" u. "Um-Schreibung"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    


    <!-- genetisches Dokument -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K192">
        <skos:prefLabel xml:lang="de">genetisches Dokument</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Rand", "Entzifferung" u. "Hypertext"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K193">
        <skos:prefLabel xml:lang="de">metaschriftliche Notiz</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Rand</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K194">
        <skos:prefLabel xml:lang="de">Reinschrift</skos:prefLabel>
        <skos:note xml:lang="de">handschriftliches Stadium eines Textes, das grundsätzlich keine
            Streichungen mehr enthält und grundsätzlich die letzte Phase der Textgenese darstellt;
            vom Autor selbst oder einem Sekretär angefertigt.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Textgenetische Phase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K196">
        <skos:prefLabel xml:lang="de">Schreiber</skos:prefLabel>
        <skos:note xml:lang="de">derjenige, dessen Hand den Text auf einem Schriftträger fixiert; im
            weiteren Sinne auch derjenige, der auf der Schreibmaschine oder am Computer Texte
            niederschreibt; Schreiber ist nicht systematisch synonym mit Autor (siehe
            Schreiberhand).</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Duktus</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K198">
        <skos:prefLabel xml:lang="de">Schreiberhand</skos:prefLabel>
        <skos:note xml:lang="de">ein Schriftstück ist von "Schreiberhand", wenn es nicht eigenhändig
            vom Autor geschrieben ist.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K199">
        <skos:prefLabel xml:lang="de">Schreibphase</skos:prefLabel>
        <skos:note xml:lang="de">zeitliche und inhaltliche Einheit eines Schreibvorganges; nach
            einer mehr oder weniger langen Unterbrechung kann eine neue Schreibphase
            beginnen.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>






    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K201">
        <skos:prefLabel xml:lang="de">Unterbrechung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibphase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Schreibprozeß -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K202">
        <skos:prefLabel xml:lang="de">Schreibprozeß</skos:prefLabel>
        <skos:altLabel xml:lang="de">Schreibprozess</skos:altLabel>
        <skos:note xml:lang="de">bezeichnet den gesamten Schreibakt, von der Aufstellung einer
            Wortliste bis zur Druckvorlage, Fahnenkorrektur und gegebenfalls Vorbereitung neuer
            Ausgaben.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Daktylogramm", "Genetische Ausgabe", "Wasserzeichen" u. "Paradigma"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
   

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K204">
        <skos:prefLabel xml:lang="de">Wortliste</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibprozeß</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K206">
        <skos:prefLabel xml:lang="de">Fahnenkorrektur</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibprozeß</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K207">
        <skos:prefLabel xml:lang="de">Augabe</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibprozeß</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Schreibspur -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K212">
        <skos:prefLabel xml:lang="de">Schreibspur</skos:prefLabel>
        <skos:note xml:lang="de">jede Art schriftlicher Zeichen, die auf dem Schriftträger Spuren
            hinterlassen.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Schriftträger</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K214">
        <skos:prefLabel xml:lang="de">schriftliches Zeichen</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibspur</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K217">
        <skos:prefLabel xml:lang="de">Schreiben</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibspur; meint Schreibakt? nein, eher sowas wie Schreibphase?</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Stelle -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K218">
        <skos:prefLabel xml:lang="de">Stelle</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Schreibspur", "Schreibraum", "Einfügungszeichen" u. "Umstellung"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
 

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K219">
        <skos:prefLabel xml:lang="de">Textstelle</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Schreibspur" u. "Umstellung". Zusammenführen mit "Stelle"?</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K223">
        <skos:prefLabel xml:lang="de">Schreibvorbereitungsphase</skos:prefLabel>
        <skos:note xml:lang="de">zur Vorbereitung der eigentlichen Textabfassung dienende
            Arbeitsphase: Lesenotizen, Pläne, Personenlisten, thematische Listen, Skizzen, Entwürfe
            usw.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K225">
        <skos:prefLabel xml:lang="de">Arbeitsphase</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu
            Schreibvorbereitungsphase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K228">
        <skos:prefLabel xml:lang="de">Personenliste</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu
            Schreibvorbereitungsphase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    
    <!-- Thematische Liste -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K229">
        <skos:prefLabel xml:lang="de">thematische Liste</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu
            Schreibvorbereitungsphase</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K230"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Liste -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K230">
        <skos:prefLabel xml:lang="de">Liste</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu
            Schreibvorbereitungsphase</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K229"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    <!-- Schreibwerkzeug -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K233">
        <skos:prefLabel xml:lang="de">Schreibwerkzeug</skos:prefLabel>
        <skos:note xml:lang="de">jedes Arbeitsgerät, das zum Festschreiben graphischer Zeichen auf
            einen bestimmten Schriftträger dient: Schilfrohr, Stichel, Griffel, Gänsekiel,
            Stahlfeder, Bleistift, Füllfederhalter; Schreibmaschine und Computer sind die
            "Werkzeuge" des nicht handschriftlichen Schreibens.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K247"/> <!-- Werkzeug des nicht handschriftlichen Schreibens -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248"/> <!-- Werkzeug des handschriftlichen Schreibens -->
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Moderne Kodikologie" u. "Materielle Beschreibung"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    
    <!-- Arbeitsgerät -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K234">
        <skos:prefLabel xml:lang="de">Arbeitsgerät</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K235">
        <skos:prefLabel xml:lang="de">Festschreiben graphischer Zeichen</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- K237: Schilfrohr  -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K237">
        <skos:prefLabel xml:lang="de">Schilfrohr</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- K238: Stichel -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K238">
        <skos:prefLabel xml:lang="de">Stichel</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- K239: Griffel  -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K239">
        <skos:prefLabel xml:lang="de">Griffel</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- K240: Gänsekiel -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K240">
        <skos:prefLabel xml:lang="de">Gänsekiel</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- K241: Stahlfeder -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K241">
        <skos:prefLabel xml:lang="de">Stahlfeder</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- K242: Bleistift -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K242">
        <skos:prefLabel xml:lang="de">Bleistift</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- K243: Füllfederhalter --> 
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K243">
        <skos:prefLabel xml:lang="de">Füllfederhalter</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



