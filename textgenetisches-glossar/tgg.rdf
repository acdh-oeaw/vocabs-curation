        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Holztafel -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K256">
        <skos:prefLabel xml:lang="de">Holztafel</skos:prefLabel>
