    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K257">
        <skos:prefLabel xml:lang="de">moderne Handschrift</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schriftträger</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <!-- Segment -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K259">
        <skos:prefLabel xml:lang="de">Segment</skos:prefLabel>
        <skos:note xml:lang="de">sprachliche Einheit unterschiedlicher Länge: Wort, Wortgruppe,
            Satz, Abschnitt, Kapitel.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K264"/> <!-- Abschnitt -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K261"/> <!-- Wort -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K262"/> <!-- Wortgruppe -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K263"/> <!-- Satz -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K265"/> <!-- Kapitel -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Ersetzung", "Substitution" u. "Streichung"</skos:editorialNote>
    </skos:Concept>
    
    
    <!-- sprachliche Einheit -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K260">
        <skos:prefLabel xml:lang="de">sprachliche Einheit</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Segment", "Paradigma" u. "Variante"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <!-- Wort -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K261">
        <skos:prefLabel xml:lang="de">Wort</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Segment" u. "Um-Schreibung"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K259"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    <!-- Wortgruppe -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K262">
        <skos:prefLabel xml:lang="de">Wortgruppe</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Segment</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K259"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Satz -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K263">
        <skos:prefLabel xml:lang="de">Satz</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Segment</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K259"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Abschnitt -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K264">
        <skos:prefLabel xml:lang="de">Abschnitt</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Segment" u. "Um-Schreibung"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K259"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    <!-- Seite -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K266">
        <skos:prefLabel xml:lang="de">Seite</skos:prefLabel>
        <skos:note xml:lang="de">Papierfläche, auf der man schreibt; jede Seite stellt die Vorder-
            oder Rückseite eines Blattes dar.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Rand</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K267">
        <skos:prefLabel xml:lang="de">Vorderseite</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Seite</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K268">
        <skos:prefLabel xml:lang="de">Rückseite</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Seite</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Skizze -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K269">
        <skos:prefLabel xml:lang="de">Skizze</skos:prefLabel>
        <skos:note xml:lang="de">erste schriftliche Form eines Schreibprojektes; fließender Übergang
            zum Entwurf, der jedoch schon eine Gesamtstruktur aufweist.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Schreibvorbereitungsphase", "Produktorientiertes Schreiben", "Entwurf" u. "Textgenetische Phase"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K059"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K270">
        <skos:prefLabel xml:lang="de">Form eines Schreibprojektes</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Skizze</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K272">
        <skos:prefLabel xml:lang="de">Gesamtstruktur</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Skizze</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K274">
        <skos:prefLabel xml:lang="de">Eingriff</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Sofortkorrektur</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K278">
        <skos:prefLabel xml:lang="de">Stemma</skos:prefLabel>
        <skos:note xml:lang="de">Stammbaum, dessen unterschiedliche Verzweigungen die zeitliche
            Abfolge, Hierarchie und gegenseitige Abhängigkeit der handschriftlichen und gedruckten
            Zeugen der Textgenese darstellen.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- 
    
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K279">
        <skos:prefLabel xml:lang="de">Stammbaum</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Stemma</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    -->


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K280">
        <skos:prefLabel xml:lang="de">zeitliche Abfolge</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Stemma</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K281">
        <skos:prefLabel xml:lang="de">Hierarchie</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Stemma</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K282">
        <skos:prefLabel xml:lang="de">gegenseitige Abhängigkeit</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Stemma</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K283">
        <skos:prefLabel xml:lang="de">handschriftlicher Zeuge</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Stemma</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K369"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K284">
        <skos:prefLabel xml:lang="de">gedruckter Zeuge</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Stemma</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K369"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Streichung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K286">
        <skos:prefLabel xml:lang="de">Streichung</skos:prefLabel>
        <skos:note xml:lang="de">Tilgung eines geschriebenen Segments, entweder um es durch ein
            anderes Segment zu ersetzen (Ersetzung) oder um es definitiv zu tilgen; --&gt;
            Tilgung.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Reinschrift", "Diplomatische Transkription" und "Brouillon"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
   
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K293">
        <skos:prefLabel xml:lang="de">Szenario</skos:prefLabel>
        <skos:note xml:lang="de">eine Art Skript, worin der Autor die groben Linien festhält, die
            dem Schreibprojekt zugrunde gelegt werden; das Szenario hat mit den Didaskalien des
            Theatertextes den Nominalstil und die rudimentäre Syntax mit Verb im Präsens gemein;
            Beispiel: "Machärus. Zwingburg, Stadt – Landschaft. – Morgen, es wird Tag, Nebel. König
            Antipas auf seiner Terrasse" (Flaubert, Szenario zu Hérodias).</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K294">
        <skos:prefLabel xml:lang="de">Skript</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Szenario</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K295">
        <skos:prefLabel xml:lang="de">Linie</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Szenario</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K296">
        <skos:prefLabel xml:lang="de">Schreibprojekt</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Szenario</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K297">
        <skos:prefLabel xml:lang="de">Didaskalie</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Szenario</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


<!-- Textabfassungsphase -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K298">
        <skos:prefLabel xml:lang="de">Textabfassungsphase</skos:prefLabel>
        <altLabel xml:lang="de">Textualisierungsphase</altLabel>
        <altLabel xml:lang="de">Phase der eigentlichen Textabfassung</altLabel>
        <skos:note xml:lang="de">mit Brouillons und Arbeitshandschriften belegte Phase der
            Textkonstitution; betrifft das Kernstück der Genese.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K302">
        <skos:prefLabel xml:lang="de">Phase der Textkonstitution</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Textabfassungs- oder
            Textualisierungsphase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    <!-- Textgenese -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K304">
        <skos:prefLabel xml:lang="de">Textgenese</skos:prefLabel>
        <skos:altLabel xml:lang="de">Genese</skos:altLabel>
        <skos:note xml:lang="de">Entstehungsprozeß eines (schriftlichen) Werkes, angefangen von
            ersten schriftlichen Notizen bis hin zum edierten Text.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Stemma", "Daktylogramm", "Zeuge" u. "Textgenetische Phase"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

<!-- Notiz -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K305">
        <skos:prefLabel xml:lang="de">Notiz</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Textgenese" u. "Textgenetische Phase"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    
    <!-- Werk -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K070">
        <skos:prefLabel xml:lang="de">Werk</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Entzifferung", "Genese" u. "Textgenese"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K307">
        <skos:prefLabel xml:lang="de">edierter Text</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Textgenese</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Textgenetische Phase -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K308">
        <skos:prefLabel xml:lang="de">Textgenetische Phase</skos:prefLabel>
        <skos:note xml:lang="de">bezeichnet jede einzelne Phase, die eine Textgenese durchläuft:
            Notizen, Entwürfe, Skizzen, Pläne, Zusammenfassungen, Brouillons, Ausarbeitungen,
            Reinschriften, Abschriften, Korrekturfahnen.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:editorialNote>enthalten in der Erläuterung zu "Produktorientiertes Schreiben"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
   
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K314">
        <skos:prefLabel xml:lang="de">Zusammenfassung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Textgenetische Phase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K316">
        <skos:prefLabel xml:lang="de">Ausarbeitung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Textgenetische Phase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>






    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K318">
        <skos:prefLabel xml:lang="de">Abschrift</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Textgenetische Phase</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K320">
        <skos:prefLabel xml:lang="de">Tilgung</skos:prefLabel>
        <skos:note xml:lang="de">im allgemeinen durch einen Durchstreichungsstrich gekennzeichneter
            Vorgang; es gibt aber auch Tilgungen ohne Streichung; z.B. kann bei zwei
            aufeinanderfolgenden Abschnitten der zweite den ersten tilgen, ohne daß der erste
            durchgestrichen ist.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Streichung</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K379"/> <!-- Grundform der Überarbeitung -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
   

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K323">
        <skos:prefLabel xml:lang="de">Tilgung ohne Streichung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Tilgung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K325">
        <skos:prefLabel xml:lang="de">Überarbeitung</skos:prefLabel>
        <skos:note xml:lang="de">Um-Schreibung, Umformulierung; setzt ein schon relativ
            ausgearbeitetes Stadium der Textentstehung voraus.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Um-Schreibung"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K329">
        <skos:prefLabel xml:lang="de">Textentstehung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Überarbeitung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K330">
        <skos:prefLabel xml:lang="de">Überschreibung</skos:prefLabel>
        <skos:note xml:lang="de">Typ der Ersetzung, wobei die ursprüngliche Einheit nicht nurch
            Darüber- oder Darunterschreiben ersetzt wird, sondern indem man die neue Einheit direkt
            auf die ursprüngliche schreibt; vor allem üblich bei kurzen Wörtern oder
            grammatikalischen Korrekturen.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K331">
        <skos:prefLabel xml:lang="de">Typ der Ersetzung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Überschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K332">
        <skos:prefLabel xml:lang="de">Einheit</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Überschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K333">
        <skos:prefLabel xml:lang="de">Darüberschreiben</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Überschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K334">
        <skos:prefLabel xml:lang="de">Darunterschreiben</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Überschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K335">
        <skos:prefLabel xml:lang="de">ursprüngliche Einheit</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Überschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K336">
        <skos:prefLabel xml:lang="de">neue Einheit</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Überschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K337">
        <skos:prefLabel xml:lang="de">grammatikalische Korrektur</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Überschreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>




    <!-- Um-Schreibung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K340">
        <skos:prefLabel xml:lang="de">Um-Schreibung</skos:prefLabel>
        <skos:altLabel xml:lang="fr">réécriture</skos:altLabel>
        <skos:note xml:lang="de">jeder Schreibvorgang, der auf bereits Geschriebenes reflexiv und
            verändernd zurückkommt, gleich ob es sich um Wörter, Sätze, Abschnitte, Kapitel oder
            abgeschlossene Texte handelt; --&gt; Überarbeitung, Umformulierung</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Umformulierung", "Überarbeitung", "Schreibspur", "Korrektur" u. "Brouillon"</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K338"/> <!-- Umformulierung -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K113"/> <!-- Korrektur -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K215"/> <!-- Sofortkorrektur/Schreibvariante -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K127"/> <!-- Lesevariante/Spätkorrektur -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <!-- Umformulierung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K338">
        <skos:prefLabel xml:lang="de">Umformulierung</skos:prefLabel>
        <skos:note xml:lang="de">Um-Schreibung</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:editorialNote>Unterbegriff zur Um-Schreibung? Enthalten in der Erläuterung zu "Überarbeitung", "Lesevariante", "Freie Variante" u. "Um-Schreibung"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K340"/> <!-- Um-Schreibung -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    
    <!-- Schreibvariante --> <!-- Sofortkorrektur -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K215">
        <skos:prefLabel xml:lang="de">Schreibvariante</skos:prefLabel>
        <skos:altLabel xml:lang="de">Sofortkorrektur</skos:altLabel>
        <skos:note xml:lang="de">Um-Schreibung, die unmittelbar beim Schreiben erfolgt; Eingriff, durch den z.B. ein Wort sofort gestrichen und rechts
            daneben durch das entsprechende neue Wort ersetzt wird. Man erkennt
            sie an der Stelle, an der sie steht: gleich rechts neben der durchgestrichenen
            Textstelle auf derselben Zeile; Synonym: Sofortkorrektur; Gegenteil: Lesevariante,
            Spätkorrektur</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Lesevariante", "Schreibspur" u. "Spätkorrektur"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K340"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <!-- Konzept http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K215 war die Schreibvariante -->
    
    
    <!-- Lesevariante --><!-- Spätkorrektur -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K127">
        <skos:prefLabel xml:lang="de">Lesevariante</skos:prefLabel>
        <skos:altLabel xml:lang="de">Spätkorrektur</skos:altLabel>
        <skos:note xml:lang="de">Umformulierung, die nach einer Unterbrechung des Schreibvorgangs,
            im allgemeinen nach kritischem Durchlesen, erfolgt; ihr Platz befindet sich im
            zwischenzeiligen Raum oder am Rand. Eingriff, durch den z.B. ein Wort anläßlich eines kritischen
            Überlesens gestrichen und ersetzt wird; im Unterschied zu der Sofortkorrektur läßt sich
            im Fall der Spätvariante nicht klären, zu welchem Zeitpunkt sie erfolgt; "spät" heißt
            hier nur "nicht sofort"  Synonym: Spätkorrektur; Gegensatz: Schreibvariante,
            Sofortkorrektur.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296 u. 298.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Spätkorrektur", "Schreibspur" u. "Lesevariante"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K340"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    <!-- Spätkorrektur -->
    <!-- <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K275">
        <skos:prefLabel xml:lang="de">Spätkorrektur</skos:prefLabel>
        <skos:note xml:lang="de">Eingriff, durch den z.B. ein Wort anläßlich eines kritischen
            Überlesens gestrichen und ersetzt wird; im Unterschied zu der Sofortkorrektur läßt sich
            im Fall der Spätvariante nicht klären, zu welchem Zeitpunkt sie erfolgt; "spät" heißt
            hier nur "nicht sofort"</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibspur</skos:editorialNote>
        <skos:editorialNote xml:lang="de">aus der note zu Lesevariante</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept> -->
    
    
    
    <!-- Korrektur -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K113">
        <skos:prefLabel xml:lang="de">Korrektur</skos:prefLabel>
        <skos:note xml:lang="de">Um-Schreibung, die sprachliche Fehler (Grammatik, Syntax,
            Orthographie) und Schreibfehler (Lapsus) beseitigt oder das Ergebnis einer freien
            Variante an die anderen syntaktischen Elemente weitergibt; --&gt; gebundene
            Variante.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            296.</dct:source>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K340"/>
        <skos:editorialNote xml:lang="de">aus der note zu Freie Variante</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K342">
        <skos:prefLabel xml:lang="de">Geschriebenes</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Um-Schreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Kapitel -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K265">
        <skos:prefLabel xml:lang="de">Kapitel</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Segment" u. "Um-Schreibung"</skos:editorialNote>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K259"/>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K347">
        <skos:prefLabel xml:lang="de">abgeschlossener Text</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Um-Schreibung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K350">
        <skos:prefLabel xml:lang="de">Umstellung</skos:prefLabel>
        <skos:note xml:lang="de">Vorgang, bei dem der Platz einer bereits geschriebenen Textstelle
            verändert wird, z. B. wenn eine bestimmte Episode an eine andere Stelle des Romantextes
            verschoben wird.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:broader rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K379"/> <!-- Grundform der Überarbeitung -->
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K173"/> <!-- Permutation -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    
    
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K173">
        <skos:prefLabel xml:lang="de">Permutation</skos:prefLabel>
        <skos:note xml:lang="de">Vorgang, bei dem die Reihenfolge von zwei Schreibelementen (Wörter,
            Sätze, Abschnitte oder ganze Kapitel) vertauscht wird; --&gt; Umstellung.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297.</dct:source>
        <skos:related rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K350"/> <!-- Umstellung -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    


<!-- Vorgang -->
   <!--  <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K351">
        <skos:prefLabel xml:lang="de">Vorgang</skos:prefLabel>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Umstellung" u. "Tilgung"</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept> -->
    
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K354">
        <skos:prefLabel xml:lang="de">Episode</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Umstellung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K356">
        <skos:prefLabel xml:lang="de">Verschiebung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Umstellung</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K357">
        <skos:prefLabel xml:lang="de">Unentschiedene Alternative</skos:prefLabel>
        <skos:note xml:lang="de">mehrere nebeneinander bestehende Lösungen, von denen keine
            gestrichen ist.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K358">
        <skos:prefLabel xml:lang="de">Lösung</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Unentschiedene
            Alternative</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K359">
        <skos:prefLabel xml:lang="de">Variante</skos:prefLabel>
        <skos:note xml:lang="de">sprachliche Einheit, die von einer anderen, früheren oder späteren
            Form abweicht; unterschiedliche Fassungen eines Textes unterscheiden sich durch ihre
            Varianten; der Begriff der Variante setzt prinzipiell eine Fassung voraus, auf die sie
            sich bezieht; in Bezug auf diese Fassung kann in einer kritischen Ausgabe ein
            Variantenapparat erstellt werden.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K361">
        <skos:prefLabel xml:lang="de">frühere Form</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Variante</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K362">
        <skos:prefLabel xml:lang="de">spätere Form</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Variante</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K366">
        <skos:prefLabel xml:lang="de">Wasserzeichen</skos:prefLabel>
        <skos:note xml:lang="de">ein in das Papier eingeprägtes Muster; "Hauptmarke", meistens in
            figürlicher Form: Muschel, Krone usw.; kann mit einer Gegenmarke versehen sein; gibt
            Hinweis zur Herkunft, zum Format, zur Qualität und manchmal zum Zeitpunkt der
            Papierherstellung; es kann zur Datierung eines Schreibprozesses beitragen.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            299.</dct:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Textzeuge --><!-- Zeuge -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K369">
        <skos:prefLabel xml:lang="de">Textzeuge</skos:prefLabel>
        <skos:altLabel xml:lang="de">Zeuge</skos:altLabel>
        <skos:altLabel xml:lang="de">Zeuge zu Genese eines Textes</skos:altLabel>
        <skos:note xml:lang="de">schriftliches Dokument, das über die Textgenese Auskunft
            gibt.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            300.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Avant-texte" u. "dossier génétique"</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K283"/> <!-- Handschriftlicher Zeuge -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K284"/> <!-- Gedruckter Zeuge -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K370">
        <skos:prefLabel xml:lang="de">Dokument</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Zeuge</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>



    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K377">
        <skos:prefLabel xml:lang="de">durchgestrichene Einheit</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Zwischenzeiliger Raum</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

    
    <!-- Grundform der Überarbeitung -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K379">
        <skos:prefLabel xml:lang="de">Grundform der Umarbeitung</skos:prefLabel>
        <skos:note>Als Grundformen der Umarbeitung nennt Gréssillon Tilgen, Erweitern, Ersetzen und Umstellen.</skos:note>
        <skos:editorialNote xml:lang="de">nicht im Glossar enthalten</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K320"/><!-- Tilgung (K320) --> 
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K071"/> <!-- Ersetzung (K071)  -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K074"/> <!-- Erweiterung (K074) -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K350"/> <!--  Umstellung (K350) -->
        <skos:source>Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S. 250.</skos:source>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>

</rdf:RDF>
