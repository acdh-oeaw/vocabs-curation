        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K237"/> <!-- K237: Schilfrohr  --> 
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K238"/> <!-- K238: Stichel -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K239"/> <!-- K239: Griffel  -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K240"/> <!-- K240: Gänsekiel -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K241"/> <!-- K241: Stahlfeder -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K242"/> <!-- K242: Bleistift -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K243"/> <!-- K243: Füllfederhalter --> 
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Schriftträger -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K249">
        <skos:prefLabel xml:lang="de">Schriftträger</skos:prefLabel>
        <skos:note xml:lang="de">Material, auf das die handgeschriebenen Schreibspuren aufgezeichnet
            werden: Stein, Papyrus, Pergament, Wachstafel, Holztafel usw.; für die modernen
            Handschriften: Papier.</skos:note>
        <dct:source xml:lang="de">Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            298.</dct:source>
        <skos:editorialNote xml:lang="de">enthalten in der Erläuterung zu "Schreibwerkzeug", "Schreibspur", "Schreiber", "Papyrus", "Papier", "Moderne Kodikologie", "Materielle Beschreibung", "Buchrolle" u. "Blatt"</skos:editorialNote>
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K252"/> <!-- Stein -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K255"/> <!-- Wachstafel -->
        <skos:narrower rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K256"/> <!-- Holztafel -->
        <!-- Papyrus -->
        <!-- Papier -->
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>
    

    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K250">
        <skos:prefLabel xml:lang="de">Material</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schriftträger</skos:editorialNote>
        <skos:inScheme rdf:resource="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/"/>
    </skos:Concept>


    <!-- Stein -->
    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K252">
        <skos:prefLabel xml:lang="de">Stein</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schriftträger</skos:editorialNote>
