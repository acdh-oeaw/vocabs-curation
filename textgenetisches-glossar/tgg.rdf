    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K246">
        <skos:prefLabel xml:lang="de">Werkzeug</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
