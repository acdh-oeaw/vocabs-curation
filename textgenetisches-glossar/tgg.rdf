    <skos:Concept rdf:about="http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K248">
        <skos:prefLabel xml:lang="de">Werkzeug des handschriftlichen Schreibens</skos:prefLabel>
        <skos:editorialNote xml:lang="de">aus der note zu Schreibwerkzeug</skos:editorialNote>
